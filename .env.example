# Everyric2 Configuration
# Copy this file to .env and customize

# =============================================================================
# Model Settings
# =============================================================================

# HuggingFace model path (hub ID or local path)
# EVERYRIC_MODEL__PATH=cpatonn/Qwen3-Omni-30B-A3B-Instruct-AWQ-4bit

# HuggingFace cache directory - RECOMMENDED for WSL to use D: drive
# This allows sharing models across multiple projects
EVERYRIC_MODEL__CACHE_DIR=/mnt/d/huggingface_cache

# Device mapping (auto, cuda, cpu)
# EVERYRIC_MODEL__DEVICE_MAP=auto

# Torch dtype (auto, float16, bfloat16, float32)
# EVERYRIC_MODEL__TORCH_DTYPE=auto

# Use Flash Attention 2 for faster inference
# EVERYRIC_MODEL__USE_FLASH_ATTENTION=true

# Maximum audio duration in seconds (default: 2400 = 40 minutes)
# EVERYRIC_MODEL__MAX_AUDIO_DURATION=2400

# Chunk duration for long audio in seconds (default: 1800 = 30 minutes)
# EVERYRIC_MODEL__CHUNK_DURATION=1800

# =============================================================================
# Audio Settings
# =============================================================================

# Target sample rate for model input (Qwen-Omni native: 24000)
# EVERYRIC_AUDIO__TARGET_SAMPLE_RATE=24000

# Demucs model for vocal separation
# EVERYRIC_AUDIO__DEMUCS_MODEL=htdemucs

# Temporary directory for audio processing
# EVERYRIC_AUDIO__TEMP_DIR=/tmp/everyric2

# =============================================================================
# Translation Settings
# =============================================================================

# Engine: gemini | nvidia | openai | local
# "openai" speaks the OpenAI chat/completions protocol — set API_URL to point it at
# any OpenAI-compatible provider. Leave API_URL unset to use api.openai.com.
# EVERYRIC_TRANSLATE_ENGINE=openai

# Chinese models (all OpenAI-compatible — pick one):
#   DeepSeek
# EVERYRIC_TRANSLATE_API_URL=https://api.deepseek.com/v1/chat/completions
# EVERYRIC_TRANSLATE_MODEL=deepseek-chat
#   Qwen (Alibaba DashScope, international endpoint)
# EVERYRIC_TRANSLATE_API_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1/chat/completions
# EVERYRIC_TRANSLATE_MODEL=qwen-max
#   GLM (Zhipu)
# EVERYRIC_TRANSLATE_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
# EVERYRIC_TRANSLATE_MODEL=glm-4.6

# EVERYRIC_TRANSLATE_API_KEY=sk-...

# Target language: ko | en | ja | zh
# zh always means Traditional Chinese as used in Taiwan (繁體中文/台灣) — there is no
# separate zh-CN code. See REGISTER_HINTS in everyric2/translation/translator.py.
# EVERYRIC_TRANSLATE_TARGET_LANGUAGE=zh

# =============================================================================
# Output Settings
# =============================================================================

# Default output format (srt, ass, lrc, json)
# EVERYRIC_OUTPUT__DEFAULT_FORMAT=srt

# =============================================================================
# Server Settings (for API mode)
# =============================================================================

# Server host
# EVERYRIC_SERVER__HOST=0.0.0.0

# Server port
# EVERYRIC_SERVER__PORT=8000

# Enable auto-reload (development only)
# EVERYRIC_SERVER__RELOAD=false

# Number of worker processes
# EVERYRIC_SERVER__WORKERS=1

# =============================================================================
# Debug
# =============================================================================

# Enable debug mode (skips model preloading in server)
# EVERYRIC_DEBUG=false
